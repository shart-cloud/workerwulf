[Unit]
Description=wulf callback receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wulf
Group=wulf
EnvironmentFile=/etc/wulf/callbackd.env
ExecStart=/usr/local/bin/callbackd
Restart=always
RestartSec=2s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/wulf /var/lib/wulf /etc/wulf

[Install]
WantedBy=multi-user.target
