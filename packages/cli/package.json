{
  "name": "@wulf/cli",
  "version": "0.1.0",
  "description": "Cloudflare Workers security scanner \u2014 static detection of binding misconfigurations, fail-open guards, and excess capabilities, grounded in the workerwulf research findings.",
  "keywords": [
    "cloudflare",
    "workers",
    "security",
    "scanner",
    "sast",
    "wrangler",
    "least-privilege"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "wulf": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "audit": "tsx src/index.ts audit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "effect": "4.1.3",
    "oxc-parser": "0.40.1",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@wulf/core": "workspace:*",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
