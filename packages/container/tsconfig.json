{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    // The `experimental` entry is required: the default @cloudflare/workers-types
    // entry's `Container` interface has no `exec()`, `interceptOutboundTcp()` or
    // `inspect()` — the whole Wave 6 surface. See docs/wave6-containers-exec.md.
    "types": ["@cloudflare/workers-types/experimental"],
    "noEmit": true
  },
  "include": ["src/**/*"]
}
