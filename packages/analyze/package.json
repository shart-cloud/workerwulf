{
  "name": "@wulf/analyze",
  "version": "0.0.0",
  "private": true,
  "description": "The wulf rule engine: oxc AST helpers, wrangler parsing, and config, source and account rules. No Node APIs, so it runs in the CLI and in workerd.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": [
    "./src/index.ts",
    "./src/rules/**"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wulf/core": "workspace:*",
    "effect": "4.1.3",
    "oxc-parser": "0.158.0",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
