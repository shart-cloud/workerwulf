{
  // ScanHub + ScanWorkflow for one account (POSTURE_PLAN.md slice 3).
  // No public surface: no routes, no workers.dev, no preview URLs. Every request
  // also needs the WULF_TOKEN bearer secret. Access arrives with the console (slice 6).
  "name": "wulf-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  // @wulf/analyze imports the native "oxc-parser"; in workerd it gets the WASM build.
  "alias": {
    "oxc-parser": "./src/oxc-shim.worker.ts"
  },
  "vars": {
    // Set per deployment. Secrets: CLOUDFLARE_API_TOKEN (read-only), WULF_TOKEN.
    "CLOUDFLARE_ACCOUNT_ID": "",
    "KEEP_SCANS": "10"
  },
  "durable_objects": {
    "bindings": [{ "name": "SCAN_HUB", "class_name": "ScanHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScanHub"] }],
  "workflows": [{ "name": "wulf-scan", "binding": "SCAN_WORKFLOW", "class_name": "ScanWorkflow" }],
  "r2_buckets": [{ "binding": "HISTORY", "bucket_name": "wulf-history" }],
  "triggers": { "crons": ["17 */6 * * *"] },
  "observability": { "enabled": true }
}
