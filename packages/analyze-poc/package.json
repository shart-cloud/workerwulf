{
  "name": "@wulf/analyze-poc",
  "version": "0.0.0",
  "private": true,
  "description": "Proof of concept: run the wulf rule engine and oxc parser inside workerd (POSTURE_PLAN.md slice 2).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@oxc-parser/binding-wasm32-wasip1": "0.158.0",
    "@wulf/analyze": "workspace:*",
    "@wulf/core": "workspace:*",
    "effect": "4.1.3",
    "oxc-parser": "0.158.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.0.0",
    "@wulf/cli": "workspace:*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "4.108.0"
  }
}
