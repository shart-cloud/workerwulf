{
  // Local-only proof of concept. Never deployed: no routes, no workers.dev, no previews.
  "name": "wulf-analyze-poc",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  // @wulf/analyze imports the native "oxc-parser"; in workerd it gets the WASM build.
  "alias": {
    "oxc-parser": "./src/oxc-shim.worker.ts"
  }
}
